### Verify bill           PUT/bills/:billId/verify
PUT {{Base_URL}}/bills/{{BillId}}/verify
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "shopName": "บริษัท ร้านอาหาร จำกัด",
  "totalAmount": 1583
}

